import Foundation

/// Template for `Tonnage/Secrets.swift`, which is gitignored. A fresh clone needs it to compile:
///
///     cp Secrets.swift.example Tonnage/Secrets.swift
///
/// Left as-is, the shared AI proxy is off and the app asks each user for their own
/// Anthropic key in Settings. See `proxy/README.md` to point it at a deployed proxy.
enum BundledSecrets {
    /// Base URL of the deployed proxy, e.g. "https://tonnage-coach.<subdomain>.workers.dev".
    static let proxyBaseURL = ""
    /// The proxy's APP_TOKEN secret. The proxy rejects requests without it.
    static let proxyAppToken = ""
}
